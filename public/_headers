/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; worker-src 'self' blob:; child-src blob:; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://www.onemap.gov.sg; connect-src 'self' https://www.onemap.gov.sg; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/vendor/*
  Cache-Control: public, max-age=604800, immutable
